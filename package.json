{
  "name": "hillaryvance.github.io",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://hillaryvance.github.io",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "buffer": "^6.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-pdf": "^9.2.1"
  },
  "scripts": {
    "start": "parcel src/index.html --port 3000",
    "build": "parcel build src/index.html --public-url ./ --no-autoinstall",
    "test": "vitest run",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prebuild": "node scripts/clean-dist.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "chrome 100"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "parcel": "^2.14.4",
    "prettier": "^3.5.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "targets": {
    "default": {
      "context": "browser"
    }
  }
}
